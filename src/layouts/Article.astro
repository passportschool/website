---
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  updated?: string;
}
const { title, updated } = Astro.props;
const updatedFmt = updated
  ? new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(updated))
  : null;
---

<Base title={title}>
  <div class="page-band">
    <div class="container-narrow">
      <h1>{title}</h1>
    </div>
  </div>
  <div class="container-narrow section">
    <article class="prose">
      {updatedFmt && <p class="updated-line">Last updated {updatedFmt}</p>}
      <slot />
    </article>
  </div>
</Base>
