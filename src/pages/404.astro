---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found">
  <div class="page-band">
    <div class="container">
      <h1>Page Not Found</h1>
      <p>Sorry — that page doesn't exist or may have moved.</p>
    </div>
  </div>
  <div class="container section">
    <div class="card-grid" style="max-width:38rem;">
      <a class="card" href="/" style="text-decoration:none;display:block;">
        <h3 style="color:var(--maroon);">Go to the homepage</h3>
        <p>News, events, and quick links for parents and students.</p>
      </a>
      <a class="card" href="/parents-2/school-calendar/" style="text-decoration:none;display:block;">
        <h3 style="color:var(--maroon);">School calendar</h3>
        <p>Hours, OCPS calendar, and board meeting dates.</p>
      </a>
      <a class="card" href="/about-us/" style="text-decoration:none;display:block;">
        <h3 style="color:var(--maroon);">Contact the office</h3>
        <p>407-658-9900 · office@passportcharter.org</p>
      </a>
    </div>
  </div>
</Base>
