---
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/wordmark.png';

const NAV = [
  {
    label: 'For Parents',
    items: [
      ['School Calendar', '/parents-2/school-calendar/'],
      ['Enrollment Information', '/parents-2/enrollment-information/'],
      ['Title I Information', '/parents-2/title-i-information/'],
      ['Emergency Procedures', '/parents-2/emergency-procedures/'],
      ['Committees', '/parents-2/committees/'],
      ['ADDitions and Volunteering', '/additions-and-volunteering/'],
      ['Extended Day Program', '/extended-day-program/'],
      ['Parent SMS Signup', '/smsoptin/'],
    ],
  },
  {
    label: 'For Students',
    items: [
      ['School News and Information', '/students-2/school-news-and-information/'],
      ['Helpful Websites', '/students-2/helpful-websites/'],
      ['Supplies List by Grade', '/students-2/supplies-list-by-grade/'],
      ['Grading Scale', '/students-2/grading-scale/'],
      ['Student Policies', '/students-2/student-policies/'],
      ['Report Suspicious Activity', '/students-2/report-suspicious-activity/'],
    ],
  },
  {
    label: 'Our School',
    items: [
      ['About Us', '/about-us/'],
      ['Faculty and Staff', '/faculty-and-staff/'],
      ['Board Info', '/board-info/'],
      ['Privacy Policy', '/privacy-policy/'],
      ['Terms and Conditions', '/terms-conditions/'],
    ],
  },
];
---

<div class="utility-bar">
  <div class="container">
    <a href="/about-us/">5221 Curry Ford Road, Orlando, FL 32812</a>
    <a href="tel:+14076589900">407-658-9900</a>
    <a class="u-right" href="https://getfortifyfl.com/" target="_blank" rel="noopener">FortifyFL — report suspicious activity</a>
  </div>
</div>

<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label="Passport School — home">
      <Image src={wordmark} alt="Passport School" width={220} height={57} densities={[1.5, 2]} />
    </a>
    <button class="nav-burger" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"/></svg>
    </button>
    <nav class="main-nav" id="main-nav" aria-label="Primary">
      <ul class="nav-list">
        {NAV.map((group) => (
          <li class="nav-group">
            <button class="nav-toggle" type="button" aria-expanded="false">
              {group.label}
              <svg class="caret" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4z"/></svg>
            </button>
            <ul class="nav-drop">
              {group.items.map(([label, href]) => (
                <li><a href={href}>{label}</a></li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn-primary header-cta" href="/parents-2/enrollment-information/">Enrollment</a>
  </div>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.nav-burger');
  const nav = document.getElementById('main-nav');
  burger?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    burger.setAttribute('aria-expanded', String(open));
  });
  // Touch/keyboard-friendly dropdown toggles (desktop hover already works via CSS)
  document.querySelectorAll<HTMLButtonElement>('.nav-toggle').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.nav-toggle').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      btn.setAttribute('aria-expanded', String(!expanded));
      const drop = btn.parentElement?.querySelector('.nav-drop');
      document.querySelectorAll('.nav-drop').forEach((d) => d.classList.remove('open'));
      if (!expanded && drop) drop.classList.add('open');
      e.stopPropagation();
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.nav-group')) {
      document.querySelectorAll('.nav-drop').forEach((d) => d.classList.remove('open'));
      document.querySelectorAll('.nav-toggle').forEach((b) => b.setAttribute('aria-expanded', 'false'));
    }
  });
</script>
