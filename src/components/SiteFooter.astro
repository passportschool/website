---
const year = new Date().getFullYear();
const parents = [
  ['School Calendar', '/parents-2/school-calendar/'],
  ['Enrollment Information', '/parents-2/enrollment-information/'],
  ['Title I Information', '/parents-2/title-i-information/'],
  ['Emergency Procedures', '/parents-2/emergency-procedures/'],
  ['Committees', '/parents-2/committees/'],
  ['Extended Day Program', '/extended-day-program/'],
  ['Parent SMS Signup', '/smsoptin/'],
];
const students = [
  ['School News and Information', '/students-2/school-news-and-information/'],
  ['Helpful Websites', '/students-2/helpful-websites/'],
  ['Supplies List by Grade', '/students-2/supplies-list-by-grade/'],
  ['Grading Scale', '/students-2/grading-scale/'],
  ['Student Policies', '/students-2/student-policies/'],
  ['Report Suspicious Activity', '/students-2/report-suspicious-activity/'],
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <p class="footer-brand">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 6.5C2 5.7 2.7 5 3.5 5H9c.6 0 1.2.4 1.4 1L12 9.5 13.6 6c.2-.6.8-1 1.4-1h5.5c.8 0 1.5.7 1.5 1.5v10c0 .8-.7 1.5-1.5 1.5H15c-.6 0-1.2.4-1.4 1L12 20.5 10.4 19c-.2-.6-.8-1-1.4-1H3.5c-.8 0-1.5-.7-1.5-1.5v-10zM12 4.2C10.9 2.7 9.2 2 7.5 2 4.9 2 2 4.2 2 7.5" fill="none"/></svg>
          Passport School
        </p>
        <p style="margin-top:.9em;max-width:34ch;">
          An inclusive K–8 charter school in Orlando, Florida — where children with
          disabilities are educated with their non-disabled peers.
        </p>
      </div>
      <nav aria-label="For parents">
        <h3>For Parents</h3>
        <ul>
          {parents.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="For students">
        <h3>For Students</h3>
        <ul>
          {students.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>
      <div>
        <h3>Contact</h3>
        <ul>
          <li>5221 Curry Ford Road<br />Orlando, FL 32812</li>
          <li><a href="tel:+1-407-658-9900">407-658-9900</a></li>
          <li><a href="mailto:office@passportcharter.org">office@passportcharter.org</a></li>
          <li><a href="https://www.instagram.com/passportpanthers/" target="_blank" rel="noopener">@passportpanthers on Instagram</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {year} Passport School, Inc. · OCPS's first charter school</p>
      <p><a href="https://getfortifyfl.com/" target="_blank" rel="noopener">FortifyFL — report suspicious activity</a></p>
    </div>
  </div>
</footer>
